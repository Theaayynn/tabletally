# Copy this file to .env (local dev) and set the same values as Environment
# Variables in your Vercel project settings for deployment.

# --- Database -----------------------------------------------------------
# Any standard PostgreSQL connection string works (Supabase, Neon, RDS,
# local Postgres...). For Supabase specifically:
#   1. Create a project at https://supabase.com
#   2. Project Settings -> Database -> Connection string -> "Transaction"
#      pooler (this is the one that works from serverless/Vercel functions).
#   3. Copy it here and append ?sslmode=require if it isn't already there.
# Example (Supabase pooled connection, port 6543):
# DATABASE_URL="postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require"
DATABASE_URL="postgresql://appuser:apppassword@localhost:5432/restaurant_manager"

# --- Auth -----------------------------------------------------------------
# Secret used to sign session JWTs. Generate a strong random value, e.g.:
#   openssl rand -base64 48
# Never reuse the example value below outside local development.
JWT_SECRET="change-me-to-a-long-random-string"
